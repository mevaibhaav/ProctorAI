{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ProctorAI: Backend",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ProctorAI: Frontend",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ProctorAI: Start both",
      "dependsOn": ["ProctorAI: Backend", "ProctorAI: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
